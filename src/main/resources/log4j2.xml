<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n" />
        </Console>
        <File name="File" fileName="logs/selenium-framework.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n" />
        </File>
    </Appenders>
    <Loggers>
        <Root level="info">
            <!-- Logs serão impressos no console e em um arquivo -->
            <AppenderRef ref="Console" />
            <!-- Formatação do log para o arquivo: Timestamp, Thread, Log Level, Class Name, Message -->
            <AppenderRef ref="File" />
        </Root>
    </Loggers>
</Configuration>
